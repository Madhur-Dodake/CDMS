PROJECT_NAME="CDMS - Cricket Data Management System"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True

# Database Configuration (PostgreSQL)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=cdms_user
POSTGRES_PASSWORD=cdms_password
POSTGRES_DB=cdms_db
DATABASE_URL=postgresql://cdms_user:cdms_password@localhost:5432/cdms_db

# CORS Configuration
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

